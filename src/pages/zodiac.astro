---
// @ts-nocheck
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCarousel from "../components/ArticleCarousel.astro";
import "../styles/articles.css";
import "../styles/article-stacked.css";
import "../styles/series-redesign.css";
import { getCollection } from "astro:content";
const posts = (await getCollection("posts"))
  .filter((post) => post.data.series === "zodiac")
  .sort((a, b) => (a.data.seriesNumber ?? 9999) - (b.data.seriesNumber ?? 9999));
---
<BaseLayout title="Zodiac Series | Lystaria" description="A grounded exploration of the twelve zodiac archetypes" image="/banner.png" type="website">
  <div class="series-redesign">
    <header class="series-hero">
      <h1>Zodiac Series</h1>
      <p class="series-subtitle">A grounded exploration of the twelve zodiac archetypes</p>
    </header>
    <section class="series-intro" aria-label="About this series">
      <p>The zodiac is more than personality traits or prediction. Each sign is an archetype: a pattern of energy, emotion, instinct, and expression that shows up in real life.</p>
      <p>This series explores each sign in a practical, grounded way, focusing on themes, emotional patterns, shadow edges, strengths, and the kind of personal magic that pairs naturally with that energy.</p>
      <p>These posts are built for clarity, self-awareness, and intentional living.</p>
    </section>
    <section class="series-subscribe" aria-label="Subscribe to series updates">
      <h2>Subscribe</h2>
      <p>Get notified when new Zodiac posts are published.</p>
      <form action="https://buttondown.com/api/emails/embed-subscribe/asteriamoon" method="post" class="subscribe-form">
        <div class="subscribe-field">
          <label for="bd-email">Email address</label>
          <input type="email" name="email" id="bd-email" autocomplete="email" required placeholder="you@example.com" />
        </div>
        <button type="submit">Subscribe</button>
      </form>
    </section>
    <div class="series-posts article-stacked-list">
      <ArticleCarousel title="Explore the Series" subtitle="Read each part of the journey." posts={posts} viewAllHref="/blog" />
    </div>
  </div>
</BaseLayout>
