---
// @ts-nocheck
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCarousel from "../components/ArticleCarousel.astro";
import "../styles/articles.css";
import "../styles/article-stacked.css";
import "../styles/series-redesign.css";
import { getCollection } from "astro:content";
const posts = (await getCollection("posts"))
  .filter((post) => post.data.series === "spellcrafting")
  .sort((a, b) => (a.data.seriesNumber ?? 9999) - (b.data.seriesNumber ?? 9999));
---
<BaseLayout title="Spellcrafting Series | Lystaria" description="A 15-part journey into the foundations of practical magic" image="/banner.png" type="website">
  <div class="series-redesign">
    <header class="series-hero">
      <h1>Spellcrafting Series</h1>
      <p class="series-subtitle">A 15-part journey into the foundations of practical magic</p>
    </header>
    <section class="series-intro" aria-label="About this series">
      <p>This series breaks down the mechanics of spellwork—demystifying the “how” and “why” behind crafting intentional magic. Whether you're new to the craft or refining your practice, these posts offer a foundational framework for understanding spells as tools of transformation, not mystical secrets.</p>
    </section>
    <section class="series-subscribe" aria-label="Subscribe to series updates">
      <h2>Subscribe</h2>
      <p>Get notified when new Spellcrafting posts are published.</p>
      <form action="https://buttondown.com/api/emails/embed-subscribe/asteriamoon" method="post" class="subscribe-form">
        <div class="subscribe-field">
          <label for="bd-email">Email address</label>
          <input type="email" name="email" id="bd-email" autocomplete="email" required placeholder="you@example.com" />
        </div>
        <button type="submit">Subscribe</button>
      </form>
    </section>
    <div class="series-posts article-stacked-list">
      <ArticleCarousel title="Explore the Series" subtitle="Read each part of the journey." posts={posts} viewAllHref="/blog" />
    </div>
  </div>
</BaseLayout>
