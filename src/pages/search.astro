---
// @ts-nocheck
// Search page
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import GradientDivider from "../components/GradientDivider.astro";
import "../styles/articles.css";
import "../styles/article-stacked.css";

// Get all posts for searching
const allPosts = await getCollection("posts");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Pass posts as JSON to the client
const postsData = sortedPosts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags || [],
  pubDate: post.data.pubDate.toISOString(),
  coverImage: post.data.coverImage || "",
  category: post.data.categories?.[0] ?? "Lystaria",
  readingMinutes: Math.max(1, Math.ceil((post.body ?? "").trim().split(/\s+/).filter(Boolean).length / 220)),
}));
---

<BaseLayout
  title="Search · Lystaria"
  description="Search through all blog posts on Lystaria"
  image="/banner.png"
  type="website"
>
  <section class="search-hero search-page">
    <header class="search-header">
      <h1>Search the Grimoire</h1>
      <p class="search-intro">Find posts by title, description, or tags</p>

      <div class="search-box">
        <input
          type="text"
          id="search-input"
          placeholder="Type to search..."
          autofocus
        />
        <img
          class="search-icon"
          src="/icons/search.svg"
          alt=""
          aria-hidden="true"
        />
      </div>
    </header>
  </section>

  <GradientDivider />

  <section id="results-section" class="search-results search-page article-stacked-list" style="display:none;">
    <div id="search-results" class="article-carousel" style="display:none;"></div>
    <div id="no-results" class="no-results" style="display:none;">
      <p>No posts found. Try different keywords.</p>
    </div>
  </section>
  <section class="search-all search-page article-stacked-list">
    <div id="all-posts" class="article-carousel">
      {sortedPosts.map((post) => {
        const readingMinutes = Math.max(1, Math.ceil((post.body ?? "").trim().split(/\s+/).filter(Boolean).length / 220));
        return (
          <a class="article-card" href={`/blog/${post.id}`} aria-label={post.data.title}>
            <div class="article-image">
              {post.data.coverImage && <img src={post.data.coverImage} alt="" loading="lazy" />}
            </div>
            <div class="article-content">
              <span class="article-category">{post.data.categories?.[0] ?? "Lystaria"}</span>
              <h2 class="article-title">{post.data.title}</h2>
              <p class="article-description">{post.data.description}</p>
              <span class="article-reading-time">{readingMinutes} min read</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <script define:vars={{ postsData }}>
    const searchInput = document.getElementById("search-input");
    const searchResults = document.getElementById("search-results");
    const noResults = document.getElementById("no-results");
    const allPosts = document.getElementById("all-posts");
    const resultsSection = document.getElementById("results-section");

    function createPostCard(post) {
      const link = document.createElement("a");
      link.className = "article-card";
      link.href = `/blog/${encodeURIComponent(post.slug)}`;
      link.setAttribute("aria-label", post.title);

      const imageWrap = document.createElement("div");
      imageWrap.className = "article-image";
      if (post.coverImage) {
        const img = document.createElement("img");
        img.src = post.coverImage;
        img.alt = "";
        img.loading = "lazy";
        imageWrap.append(img);
      }

      const content = document.createElement("div");
      content.className = "article-content";
      const category = document.createElement("span");
      category.className = "article-category";
      category.textContent = post.category;
      const title = document.createElement("h2");
      title.className = "article-title";
      title.textContent = post.title;
      const description = document.createElement("p");
      description.className = "article-description";
      description.textContent = post.description;
      const time = document.createElement("span");
      time.className = "article-reading-time";
      time.textContent = `${post.readingMinutes} min read`;
      content.append(category, title, description, time);
      link.append(imageWrap, content);
      return link;
    }

    function searchPosts(query) {
      if (!query.trim()) {
        resultsSection.style.display = "none";
        searchResults.innerHTML = "";
        searchResults.style.display = "none";
        noResults.style.display = "none";
        allPosts.style.display = "flex";
        return;
      }

      resultsSection.style.display = "block";

      const lowerQuery = query.toLowerCase();
      const results = postsData.filter((post) => {
        const titleMatch = post.title.toLowerCase().includes(lowerQuery);
        const descMatch = post.description.toLowerCase().includes(lowerQuery);
        const tagsMatch = post.tags.some((tag) =>
          tag.toLowerCase().includes(lowerQuery),
        );
        return titleMatch || descMatch || tagsMatch;
      });

      allPosts.style.display = "none";

      if (results.length === 0) {
        searchResults.innerHTML = "";
        searchResults.style.display = "none";
        noResults.style.display = "block";
      } else {
        searchResults.replaceChildren(...results.map(createPostCard));
        searchResults.style.display = "flex";
        noResults.style.display = "none";
      }
    }

    searchInput.addEventListener("input", (e) => {
      searchPosts(e.target.value);
    });
  </script>
</BaseLayout>

<style is:global>
  /* Match the redesigned blog typography and tighten the search-to-results flow. */
  .search-page {
    font-family: system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
  }
  .search-page .search-intro,
  .search-page .article-category,
  .search-page .article-description,
  .search-page .article-reading-time,
  .search-page .no-results {
    font-family: system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
  }
  .search-page .article-title,
  .search-page .search-header h1 {
    font-family: "Berkshire Swash", Georgia, serif;
  }
  .search-page.search-hero {
    padding-bottom: 0 !important;
    margin-bottom: 0 !important;
    min-height: 0 !important;
  }
  .search-page .search-header {
    margin-bottom: 0;
  }
  .search-page .search-box {
    margin-bottom: 0;
  }
  .search-hero + .gradient-divider {
    margin: 1.25rem auto !important;
  }
  .search-page.search-all,
  .search-page.search-results {
    padding-top: 0 !important;
    margin-top: 0 !important;
  }
  /* variables scoped to this page wrapper */
  .search-page .article-card { text-decoration: none; }
  .search-page {
    --card-radius: 12px;
    --card-pad: 1.25rem;
    --stack-gap: 0.75rem;
    padding-inline: 1.25rem;
  }

  /* =========================
     NEW SECTION HOOKS (added in markup)
     ========================= */
  .search-page.search-hero,
  .search-page.search-results,
  .search-page.search-all {
    width: 100%;
  }

  /* give the top section breathing room without crushing sides */
  .search-page.search-hero {
    padding-top: 2rem;
    padding-bottom: 0.5rem;
  }

  /* all-posts area spacing */
  .search-page.search-all {
    padding-bottom: 2rem;
  }

  /* =========================
     HEADER + SEARCH BOX
     ========================= */
  .search-page .search-header {
    text-align: center;
    border-bottom: none;
    margin-bottom: 1.25rem;
  }

  .search-page .search-intro {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .search-page.search-results {
    padding: 0 !important;
    margin: 0 !important;
    min-height: 0 !important;
  }

  .search-page .search-box {
    position: relative;
    max-width: 900px;
    margin: 0 auto 1.5rem;
  }

  .search-page #search-input {
    width: 100%;
    /*
      This padding is intentional:
      - right padding (3rem) keeps your typed text from going underneath the icon
      - left padding (1.5rem) keeps text comfy from the edge
    */
    padding: 1rem 3rem 1rem 1.5rem;
    background-color: var(--color-bg-secondary);
    border: 2px solid var(--color-border);
    border-radius: 50px;
    color: var(--color-text);
    font-size: 1rem;
    font-family: system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
    transition: border-color 0.3s ease;
  }

  .search-page #search-input:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .search-page #search-input::placeholder {
    color: var(--bold-text-color);
  }

  .search-page .search-icon {
    position: absolute;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    pointer-events: none;
    opacity: 0.8;
  }

  .search-page .no-results {
    text-align: center;
    padding: 4rem 0;
    color: var(--color-text-muted);
    font-size: 1.2rem;
  }

  /* =========================
     MOBILE SETTINGS
     ========================= */
  @media (max-width: 1100px) {
    .search-page {
      padding-inline: 1.25rem; /* ← slightly more than before */
      --card-pad: 1rem;
    }

    .search-page.search-hero {
      padding-top: 1.5rem;
      padding-bottom: 2rem;
    }

    .search-page .search-header h1 {
      font-size: 2rem;
    }
  }
</style>
