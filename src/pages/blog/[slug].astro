---
// src/pages/blog/[slug].astro
// @ts-nocheck
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Comments from "../../components/Comments.astro";
import "../../styles/articles.css";
import "../../styles/article-detail.css";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<"posts"> };
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);

const formattedDate = new Date(post.data.pubDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title={post.data.title + " · Lystaria"}
  description={post.data.description}
  image={post.data.coverImage || "/banner.png"}
  type="article"
>
  <div id="progress-bar"></div>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      author: { "@type": "Person", name: "Asteria" },
      datePublished: post.data.pubDate.toISOString(),
      url: `https://lystaria.im/blog/${post.id.replace(/\.(md|mdx)$/, "")}`,
    })}
  />
  <div class="post-container">
    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>

      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>

        {
          post.data.tags && (
            <div class="post-tags">
              {post.data.tags.map((tag) => (
                <a href={`/blog/tag/${tag}`} class="tag-link">
                  <span class="tag">{tag}</span>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    {tocHeadings.length > 0 && (
      <nav aria-label="Article table of contents">
        <details class="article-toc">
          <summary>In this article</summary>
          <ol>
            {tocHeadings.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </details>
      </nav>
    )}

    <div class="post-content">
      <Content />
    </div>

    <Comments />
  </div>
</BaseLayout>



<script>
  function updateProgressBar() {
    const progressBar = document.getElementById("progress-bar");
    const windowHeight = window.innerHeight;
    const documentHeight = document.documentElement.scrollHeight - windowHeight;
    const scrolled = window.scrollY;
    const progress = (scrolled / documentHeight) * 100;

    if (progressBar) progressBar.style.width = progress + "%";
  }

  window.addEventListener("scroll", updateProgressBar);
  updateProgressBar();
</script>
