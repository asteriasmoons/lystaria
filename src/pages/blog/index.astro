---
// @ts-nocheck
// Blog listing page
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import "../../styles/articles.css";
import ArticleCarousel from "../../components/ArticleCarousel.astro";

export const prerender = true; // ← add this

// Get all posts, sorted by date (newest first)
const allPosts = await getCollection("posts");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const sections = [
  { title: "Magic", subtitle: "Magic, spellcraft, and practice.", slug: "magic" },
  { title: "Holidays", subtitle: "Celebrations, traditions, and seasonal moments.", slug: "holidays" },
  { title: "Astrology", subtitle: "The stars, signs, and celestial cycles.", slug: "astrology" },
  { title: "The Self", subtitle: "Personal reflections and self-exploration.", slug: "the-self" },
];
---

<BaseLayout
  title="Blog · Lystaria"
  description="Musings on magic, growth, and the space between the mystical and mundane."
  type="website"
>
  <section class="articles-hero" aria-labelledby="articles-title">
    <div class="articles-hero-inner">
      <p class="articles-eyebrow">THE LYSTARIA BLOG</p>
      <h1 id="articles-title">Articles</h1>
      <p class="articles-hero-description">Explore {sortedPosts.length} articles on magic, holidays, astrology, and the self.</p>
      <label class="articles-search">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="10.8" cy="10.8" r="7.3"/><path d="m16.3 16.3 5 5"/></svg>
        <input id="articles-search-input" type="search" placeholder="Search articles: magic, astrology, holidays..." autocomplete="off" aria-label="Search articles" />
      </label>
      <nav class="articles-filters" aria-label="Filter articles by category">
        <button type="button" class="articles-filter is-active" data-filter="all" aria-pressed="true">All</button>
        <button type="button" class="articles-filter" data-filter="new" aria-pressed="false">New <span>6</span></button>
        {sections.map((section) => (
          <button type="button" class="articles-filter" data-filter={section.slug} aria-pressed="false">{section.title} <span>{sortedPosts.filter((post) => post.data.categories?.includes(section.title)).length}</span></button>
        ))}
      </nav>
    </div>
  </section>
  <div class="articles-listings" id="articles-listings">
    <div data-article-section="new">
  <ArticleCarousel title="New" subtitle="Fresh from the Grimoire." posts={sortedPosts.slice(0, 6)} viewAllHref="/blog/all" showNew={true} />
    </div>
  {sections.map((section) => (
    <div data-article-section={section.slug}>
    <ArticleCarousel
      title={section.title}
      subtitle={section.subtitle}
      posts={sortedPosts.filter((post) => post.data.categories?.includes(section.title)).slice(0, 6)}
      viewAllHref={`/blog/category/${section.slug}`}
    />
    </div>
  ))}
  </div>
  <div id="articles-search-results" hidden>
    <ArticleCarousel title="Search Results" subtitle="Articles matching your search." posts={sortedPosts} viewAllHref="/blog/all" />
  </div>
  <p id="articles-no-results" hidden>No articles match your search.</p>
  <script>
    const searchInput = document.querySelector<HTMLInputElement>("#articles-search-input");
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>(".articles-filter"));
    const listings = document.querySelector<HTMLElement>("#articles-listings");
    const results = document.querySelector<HTMLElement>("#articles-search-results");
    const noResults = document.querySelector<HTMLElement>("#articles-no-results");
    let selected = "all";
    function updateArticles() {
      const query = searchInput?.value.trim().toLocaleLowerCase() ?? "";
      const searching = query.length > 0;
      if (listings) listings.hidden = searching;
      if (results) results.hidden = !searching;
      document.querySelectorAll<HTMLElement>("[data-article-section]").forEach((section) => {
        section.hidden = searching || (selected !== "all" && section.dataset.articleSection !== selected);
      });
      let count = 0;
      results?.querySelectorAll<HTMLElement>(".article-card").forEach((card) => {
        const matched = card.textContent?.toLocaleLowerCase().includes(query) ?? false;
        card.hidden = !matched;
        if (matched) count++;
      });
      if (noResults) noResults.hidden = !searching || count > 0;
    }
    filters.forEach((button) => button.addEventListener("click", () => {
      selected = button.dataset.filter ?? "all";
      filters.forEach((item) => {
        const active = item === button;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-pressed", String(active));
      });
      if (searchInput) searchInput.value = "";
      updateArticles();
    }));
    searchInput?.addEventListener("input", updateArticles);
    updateArticles();
  </script>
</BaseLayout>

