---
// @ts-nocheck
import BaseLayout from "../layouts/BaseLayout.astro";
import GradientDivider from "../components/GradientDivider.astro";

const pageTitle = "Contact - Lystaria";
const pageDescription = "Send a message to the Lystaria team.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="contact-page">
    <section class="hero">
      <h1>Contact ✦ Lystaria</h1>
      <p class="subtitle">
        Questions, feedback, support requests, or collaboration inquiries--send
        a message anytime.
      </p>
    </section>

    <GradientDivider />

    <section class="contact-info">
      <p class="description">
        <strong>We read every message.</strong> If you’re reaching out about bot support,
        include the bot name and a short description of what happened. If you’re reaching
        out about collaboration, share what you’re building and what you need.
      </p>
    </section>

    <GradientDivider />

    <section class="form-section">
      <div class="form-card">
        <h2>Send a Message</h2>

        <form id="contactForm" class="contact-form">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required />

          <label for="email">Email</label>
          <input id="email" name="email" type="email" required />

          <label for="message">Message</label>
          <textarea id="message" name="message" rows="6" required></textarea>

          <!-- Honeypot field (hidden) -->
          <input
            id="website"
            name="website"
            type="text"
            autocomplete="off"
            tabindex="-1"
            class="hp"
          />

          <button type="submit" id="sendBtn">Send Message</button>

          <p class="status" id="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById("contactForm") as HTMLFormElement | null;
  const status = document.getElementById("status") as HTMLElement | null;
  const sendBtn = document.getElementById(
    "sendBtn",
  ) as HTMLButtonElement | null;

  if (!form || !status || !sendBtn) {
    console.error("Contact form elements not found.");
  } else {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      status.textContent = "";
      sendBtn.disabled = true;

      const nameInput = form.elements.namedItem(
        "name",
      ) as HTMLInputElement | null;
      const emailInput = form.elements.namedItem(
        "email",
      ) as HTMLInputElement | null;
      const messageInput = form.elements.namedItem(
        "message",
      ) as HTMLTextAreaElement | null;
      const websiteInput = form.elements.namedItem(
        "website",
      ) as HTMLInputElement | null;

      if (!nameInput || !emailInput || !messageInput || !websiteInput) {
        status.textContent = "Form fields are missing.";
        sendBtn.disabled = false;
        return;
      }

      const payload = {
        name: nameInput.value,
        email: emailInput.value,
        message: messageInput.value,
        website: websiteInput.value,
      };

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
          status.textContent = data.error || "Something went wrong.";
          sendBtn.disabled = false;
          return;
        }

        form.reset();
        status.textContent = "Message sent. Thank you.";
      } catch (err) {
        status.textContent = "Failed to send. Please try again.";
      } finally {
        sendBtn.disabled = false;
      }
    });
  }
</script>

<style>
  .hero {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .subtitle {
    font-size: 0.85rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.909);
    max-width: 700px;
    margin: 0 auto;
  }

  .contact-info {
    text-align: center;
  }

  .description {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
    padding: 2rem;
    border: 2px dotted transparent;
    border-color: #AD9BC5;
    font-size: 0.85rem;
    color: #ffffff;
  }

  .form-section {
    text-align: center;
    margin-top: 1rem;
  }

  .form-card {
    position: relative;
    max-width: 620px;
    width: min(100%, 620px);
    margin: 0 auto;
    padding: 1.2rem 1.2rem 0.4rem;
    border-radius: 10px;
    background: #AD9BC5;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.06) inset,
      0 10px 30px rgba(0, 0, 0, 0.35);
    text-align: left;
  }

  .form-card h2 {
    text-align: center;
    margin-bottom: 0.8rem;
  }

  .contact-form {
    display: grid;
    gap: 0.55rem;
  }

  label {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.85);
  }

  input,
  textarea {
    width: 100%;
    padding: 0.72rem 0.9rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(0, 0, 0, 0.35);
    color: #fff;
    font-size: 0.95rem;
    outline: none;
  }

  textarea {
    min-height: 150px;
  }

  input:focus,
  textarea:focus {
    border-color: rgba(255, 255, 255, 0.3);
  }

  button {
    margin-top: 0.25rem;
    padding: 0.75rem 1.35rem;
    font-size: 0.95rem;
    justify-self: center;
    font-family: "Berkshire Swash", serif;
    font-weight: 600;
    border-radius: 10px;
    background: #AD9BC5;
    border: none;
    color: #ffffff;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }

  button:hover {
    background: #AD9BC5;
    transform: translateY(-2px);
    box-shadow:
      0 6px 20px rgba(0, 0, 0, 0.4),
      0 0 30px rgba(90, 200, 250, 0.3);
  }

  button:active {
    transform: translateY(0);
  }

  button:disabled {
    opacity: 0.6;
    cursor: default;
    transform: none;
  }

  .status {
    margin-top: 0.2rem;
    min-height: 0;
    text-align: center;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  @media (max-width: 860px) {
    .subtitle {
      font-size: 0.95rem;
    }

    .form-card {
      width: min(100%, 92vw);
      max-width: 92vw;
      padding: 0.95rem 0.8rem 0.7rem;
    }

    input,
    textarea {
      font-size: 0.9rem;
      padding: 0.68rem 0.8rem;
    }

    textarea {
      min-height: 130px;
    }

    button {
      width: 100%;
      max-width: 220px;
      padding: 0.7rem 1rem;
      font-size: 0.88rem;
    }
  }
  /* Updated contact styling: dark surfaces, readable fields, restrained accents. */
  .contact-page { font-family:system-ui,-apple-system,"Helvetica Neue",Arial,sans-serif; color:#e8dfea; }
  .contact-page .hero { padding:1.5rem 0 .5rem; }
  .contact-page .hero h1 { font-family:"Berkshire Swash",serif; color:#AD9BC5; -webkit-text-fill-color:#AD9BC5; background:none; }
  .contact-page .subtitle { font-size:1rem; line-height:1.6; color:#cfc4d2; }
  .contact-page .description { padding:1.4rem; border:1px solid #493d4d; border-left:4px solid #C39AAD; border-radius:14px; background:#201B23; font-size:.95rem; line-height:1.65; color:#e8dfea; text-align:left; }
  .contact-page .form-section { margin:1.5rem 0 3rem; }
  .contact-page .form-card { box-sizing:border-box; width:100%; max-width:720px; padding:clamp(1.25rem,4vw,2rem); border:1px solid #55465b; border-top:3px solid #AD9BC5; border-radius:18px; background:#211c26; }
  .contact-page .form-card h2 { font-family:"Berkshire Swash",serif; color:#f8f3f9; -webkit-text-fill-color:#f8f3f9; background:none; margin:0 0 1.4rem; font-size:clamp(1.6rem,4vw,2rem); }
  .contact-page .contact-form { gap:.55rem; }
  .contact-page .contact-form label { font-family:inherit; font-size:.95rem; font-weight:600; color:#e6dbe8; margin-top:.55rem; }
  .contact-page .contact-form input:not(.hp), .contact-page .contact-form textarea { box-sizing:border-box; display:block; width:100%; min-width:0; border:1px solid #74617b; border-radius:12px; padding:.85rem 1rem; background:#151219; color:#fff; font-family:inherit; font-size:1rem; line-height:1.5; }
  .contact-page .contact-form textarea { min-height:160px; resize:vertical; }
  .contact-page .contact-form input:focus-visible,.contact-page .contact-form textarea:focus-visible,.contact-page .contact-form button:focus-visible { outline:2px solid #C39AAD; outline-offset:2px; }
  .contact-page .contact-form button { justify-self:start; margin-top:1rem; padding:.85rem 1.6rem; background:#AD9BC5; color:#19141d; font:600 1rem system-ui,-apple-system,sans-serif; box-shadow:none; }
  .contact-page .contact-form button:hover { background:#C39AAD; box-shadow:none; }
  .contact-page .status { text-align:left; color:#e6dbe8; }
  @media(max-width:860px){.contact-page .form-card{width:100%;max-width:100%;padding:1.25rem}.contact-page .contact-form button{width:100%;max-width:none;justify-self:stretch}.contact-page .contact-form input:not(.hp),.contact-page .contact-form textarea{font-size:1rem}}
</style>
